{
  "expo": {
    "name": "AlifPlay",
    "slug": "alifplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/logoicononly.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/branding/logowithtexttrans.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFD93D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salmanazam.alifplay"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/logoicononlytrans.png",
        "backgroundColor": "#FFD93D"
      },
      "package": "com.salmanazam.alifplay",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
