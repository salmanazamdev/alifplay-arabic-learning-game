{
  "expo": {
    "name": "AlifPlay",
    "slug": "alifplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/logoicononly.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/branding/logowithtexttrans.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFD93D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salmanazam.alifplay"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/logoicononlytrans.png",
        "backgroundColor": "#FFD93D"
      },
      "package": "com.salmanazam.alifplay",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "4d4a6ec4-6ae8-4112-9b80-bea35f0a036a"
      }
    }
  }
}
